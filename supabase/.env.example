# =====================================================
# SUPABASE CONFIGURATION
# =====================================================

# Supabase Project URL
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public)
# Get from: Supabase Dashboard → Settings → API
# Safe to use in frontend
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Secret)
# Get from: Supabase Dashboard → Settings → API
# NEVER expose in frontend - backend only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =====================================================
# JWT CONFIGURATION
# =====================================================

# JWT Secret (must match Supabase JWT secret)
# Get from: Supabase Dashboard → Settings → API → JWT Secret
JWT_SECRET=your-jwt-secret-here

# JWT Expiration Time
JWT_EXPIRES_IN=7d

# =====================================================
# DATABASE DIRECT CONNECTION (Optional)
# =====================================================

# PostgreSQL Connection String
# Get from: Supabase Dashboard → Settings → Database
# Format: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Database Host
DB_HOST=db.your-project.supabase.co

# Database Port
DB_PORT=5432

# Database Name
DB_NAME=postgres

# Database User
DB_USER=postgres

# Database Password
DB_PASSWORD=your-database-password

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================

# Node Environment
NODE_ENV=production

# Server Port
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# API Base URL
API_URL=https://your-api-domain.com

# =====================================================
# SECURITY
# =====================================================

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Cookie Secret (for session management)
COOKIE_SECRET=your-random-secret-here

# =====================================================
# OPTIONAL: EMAIL CONFIGURATION
# =====================================================

# SMTP Configuration (if using custom email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email From Address
EMAIL_FROM=noreply@your-domain.com

# =====================================================
# OPTIONAL: LOGGING
# =====================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# =====================================================
# NOTES
# =====================================================
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Keep service role key secret
# 4. Rotate keys regularly for security
# 5. Use different keys for dev/staging/production
